<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.effect.GaussianBlur?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="1000.0" styleClass="root" stylesheets="@css/entranceCSS.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controller.ConnectedListController">

    <children>
        <!-- Фоновое изображение -->
        <ImageView fitHeight="600.0" fitWidth="1000.0" preserveRatio="false">
            <image>
                <Image url="@images/frog.jpg" />
            </image>
            <effect>
                <GaussianBlur radius="20" />
            </effect>
        </ImageView>

        <!-- Логотип и название -->
        <HBox alignment="CENTER_LEFT" layoutX="50.0" layoutY="30.0" spacing="10.0">
            <ImageView fitHeight="100.0" fitWidth="100.0">
                <image>
                    <Image url="@images/frog.jpg" />
                </image>
            </ImageView>
            <Text styleClass="bestschool-text" text="BESTschoolEVER" />
        </HBox>
        <Text fx:id="backText" layoutX="911.0" layoutY="31.0" onMouseClicked="#handleBack" styleClass="back-text-style" text="Назад" />
        <AnchorPane layoutX="92.0" layoutY="138.0" prefHeight="400.0" prefWidth="800.0" styleClass="card">
            <children>

                <Text layoutX="30.0" layoutY="50.0" text="Список подключенных">
                    <font>
                        <Font size="28.0" />
                    </font>
                </Text>

                <TableView fx:id="tableView" layoutX="30.0" layoutY="70.0" prefHeight="300.0" prefWidth="740.0">
                    <columns>
                        <TableColumn fx:id="loginColumn" prefWidth="539.2" text="Логин" />
                        <TableColumn fx:id="statusColumn" prefWidth="200.8" text="Статус" />
                    </columns>
                </TableView>

            </children>
        </AnchorPane>
    </children>
</AnchorPane>
