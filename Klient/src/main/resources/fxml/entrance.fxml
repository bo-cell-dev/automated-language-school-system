<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.effect.GaussianBlur?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<AnchorPane fx:id="background" prefHeight="541.0" prefWidth="845.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controller.EntranceWindow">

    <children>
        <!-- Фоновое размытое изображение -->
        <ImageView fitHeight="541.0" fitWidth="845.0" preserveRatio="false">
            <image>
                <Image url="@images/frog.jpg" />
            </image>
            <effect>
                <GaussianBlur radius="20" />
            </effect>
        </ImageView>

        <!-- Верхняя панель с логотипом и текстом -->
        <HBox alignment="CENTER_LEFT" layoutX="50" layoutY="30" spacing="10">
            <ImageView fitHeight="100" fitWidth="100">
                <image>
                    <Image url="@images/frog.jpg" />
                </image>
            </ImageView>
            <Text style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: black;" text="BESTschoolEVER" />
        </HBox>

        <!-- Центральный блок с кнопками -->
        <StackPane layoutX="50" layoutY="150">
            <AnchorPane id="backgroung" prefHeight="300.0" prefWidth="750.0" style="-fx-background-color: rgba(255,255,255,0.9); -fx-border-color: gray; -fx-border-width: 2; -fx-background-radius: 15; -fx-border-radius: 15;">
                <VBox alignment="CENTER" layoutX="225" layoutY="50" prefWidth="300" spacing="20.0">
                    <Text style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Зайти как" />

                    <!-- Кнопка Гость с сиреневым фоном -->
                    <Button fx:id="GuestEntrance" style="-fx-background-color: #9B59B6; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" text="Гость" onAction="#onGuestEntrance"/>

                    <!-- Кнопка Пользователь/Зарегистрироваться с сиреневым фоном -->
                    <Button fx:id="UserEntrance" style="-fx-background-color: #9B59B6; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" text="Пользователь/Зарегистрироваться" onAction="#onUserEntrance"/>

                    <!-- Кнопка Выйти с сиреневым фоном -->
                    <Button fx:id="ExitEntrance" style="-fx-background-color: #9B59B6; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" text="Выйти" onAction="#onExitEntrance"/>
                </VBox>
            </AnchorPane>
        </StackPane>

    </children>
</AnchorPane>
